---
// Shared <head> for every page: charset, viewport, font (local), PWA, favicon.
import '../styles/global.css';
import CookiePanel from '../components/CookiePanel.astro';

interface Props { title?: string; description?: string; lang?: string }
const {
  title = 'Digital Creative Service | Fazefactory®',
  description = 'Fazefactory®, digital creative service. Est. 2014, Italy. The new site is shaping up.',
  lang = 'en'
} = Astro.props;
// clean URL: /index.html -> /, /about.html -> /about (build.format 'file' adds .html at build time)
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/index$/, '') || '/', Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#3A1418">
  <link rel="manifest" href="/manifest.json">
  <link id="fav" rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="preload" href="/fonts/host-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script src="/registerServiceWorker.js" defer is:inline></script>
</head>
<body>
  <slot />
  <CookiePanel />
  <script>
    import "../scripts/fx.js";
  </script>
</body>
</html>
