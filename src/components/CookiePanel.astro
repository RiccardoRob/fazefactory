---
// Cookie consent panel. Black, rounded, white type; Braun-style outline controls (after Dieter Rams:
// thin white stroke, no fill, round ends). Bottom-right, on the page's Swiss grid and 8 px baseline.
// It manages consent by purpose only (no cookie list yet). English only for now.
// The choice is kept in localStorage ("ff-consent") and announced as a "ff:consent" event, so scripts that
// need consent (analytics, later) can wait for it: window.ffConsent?.analytics === true.
// Any element with [data-ck-open] reopens the panel (the "Cookies" link in the footer).
---
<!-- The cookie mark, drawn here (no download), after Büro Destruct: one solid geometric body on a 24-unit
     grid, a round bite out of its top-right, and square chips cut out on the grid. Reused by the footer link. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <mask id="ck-m" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
    <rect width="24" height="24" fill="#fff"/>
    <circle cx="20" cy="4" r="5" fill="#000"/>
    <rect x="6" y="7" width="3" height="3" fill="#000"/>
    <rect x="12" y="10" width="3" height="3" fill="#000"/>
    <rect x="7" y="14" width="3" height="3" fill="#000"/>
    <rect x="15" y="16" width="3" height="3" fill="#000"/>
    <circle cx="17.5" cy="11" r=".9" fill="#000"/>
    <circle cx="11.5" cy="18.5" r=".9" fill="#000"/>
  </mask>
  <symbol id="ck-i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="currentColor" mask="url(#ck-m)"/></symbol>
</defs></svg>
<section id="ck" role="dialog" aria-labelledby="ck-t" aria-describedby="ck-d" hidden>
  <div class="ck-in">
    <div class="ck-h"><svg class="ck-ic" aria-hidden="true"><use href="#ck-i"/></svg><h2 class="ck-k" id="ck-t">Your privacy matters.</h2></div>
    <hr class="ck-r" aria-hidden="true">
    <p class="ck-p" id="ck-d">We use cookies to keep this site working. With your consent, we also use them to remember your preferences and to understand how the site is used.</p>

    <ul class="ck-l" id="ck-set" hidden>
      <li><div><span class="ck-n">Necessary</span><span class="ck-s">Required for the site to work. Always on.</span></div>
        <button type="button" class="ck-sw" role="switch" aria-checked="true" aria-disabled="true" aria-label="Necessary, always on" data-k="necessary"><i></i></button></li>
      <li><div><span class="ck-n">Preferences</span><span class="ck-s">Remember your choices, such as language.</span></div>
        <button type="button" class="ck-sw" role="switch" aria-checked="false" aria-label="Preferences" data-k="preferences"><i></i></button></li>
      <li><div><span class="ck-n">Analytics</span><span class="ck-s">Help us understand how the site is used.</span></div>
        <button type="button" class="ck-sw" role="switch" aria-checked="false" aria-label="Analytics" data-k="analytics"><i></i></button></li>
      <li><div><span class="ck-n">Marketing</span><span class="ck-s">Personalised content and offers.</span></div>
        <button type="button" class="ck-sw" role="switch" aria-checked="false" aria-label="Marketing" data-k="marketing"><i></i></button></li>
    </ul>

    <div class="ck-b fx-row" id="ck-main">
      <button type="button" class="fx ck-bt" data-a="reject" aria-label="Reject all"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg><span class="fx-t" aria-hidden="true">Reject all</span></button>
      <button type="button" class="fx ck-bt" data-a="settings" aria-label="Settings"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h8.5M17.5 7H20M4 17h2.5M11.5 17H20"/><circle cx="15" cy="7" r="2.5"/><circle cx="9" cy="17" r="2.5"/></svg><span class="fx-t" aria-hidden="true">Settings</span></button>
      <button type="button" class="fx ck-bt" data-a="accept" aria-label="Accept all"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7.5"/></svg><span class="fx-t" aria-hidden="true">Accept all</span></button>
    </div>
    <div class="ck-b fx-row" id="ck-save" hidden>
      <button type="button" class="fx ck-bt" data-a="reject" aria-label="Reject all"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg><span class="fx-t" aria-hidden="true">Reject all</span></button>
      <button type="button" class="fx ck-bt" data-a="save" aria-label="Save"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v10.5M7.5 10.5 12 15l4.5-4.5M5 17v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"/></svg><span class="fx-t" aria-hidden="true">Save</span></button>
      <button type="button" class="fx ck-bt" data-a="accept" aria-label="Accept all"><span class="fx-p" aria-hidden="true"><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7.5"/></svg><span class="fx-t" aria-hidden="true">Accept all</span></button>
    </div>
  </div>
</section>

<style is:global>
  /* Swiss grid: the panel spans 4 of the page's 12 columns (6 on mid screens, all 12 on phones), sits on the
     bottom and right margins, and keeps the 8 px baseline inside: 3u padding, 1u / 2u / 3u steps. */
  #ck{
    --c:calc((100vw - 13 * var(--g)) / 12);                       /* one column of main's grid */
    /* it stands clear of the copyright line: its foot is level with the indicators (aligned in the script) */
    position:fixed;right:var(--g);bottom:calc(var(--g) + 17px + var(--u) * 3);z-index:20;box-sizing:border-box;
    width:max(320px, calc(var(--c) * 4 + var(--g) * 3));max-width:calc(100vw - 2 * var(--g));
    background:#000;color:#fff;border-radius:calc(var(--u) * 2);
    font:500 13px/1.5 var(--font);
    opacity:0;transform:translateY(calc(var(--u) * 2));
    transition:opacity .618s cubic-bezier(.16,1,.3,1),transform .618s cubic-bezier(.16,1,.3,1);
  }
  #ck.on{opacity:1;transform:none}
  #ck[hidden]{display:none}
  .ck-in{padding:calc(var(--u) * 3);box-sizing:border-box;height:100%;display:flex;flex-direction:column}
  /* desktop, short view: the panel is a golden rectangle (width : height = φ : 1); the buttons sit on its foot */
  @media (min-width:641px){
    #ck{width:400px}
    #ck:not(.set){aspect-ratio:1.618 / 1}
    #ck:not(.set) .ck-b{margin-top:auto;padding-top:calc(var(--u) * 2)}
  }
  .ck-h{display:flex;align-items:center;gap:calc(var(--u) * 1.5)}
  .ck-ic{width:calc(var(--u) * 4);height:calc(var(--u) * 4);flex:none;color:#fff}
  .ck-k{margin:0;font-size:20px;font-weight:700;line-height:24px;letter-spacing:-.01em}
  /* a white rule across the whole panel, edge to edge */
  .ck-r{margin:calc(var(--u) * 2) calc(var(--u) * -3) 0;border:0;height:4px;background:#fff}
  .ck-p{margin:calc(var(--u) * 2) 0 0;color:rgba(255,255,255,.72);text-wrap:pretty}
  /* settings: one row per purpose, name and line on the left, the switch on the right */
  .ck-l{list-style:none;margin:calc(var(--u) * 3) 0 0;padding:0}
  .ck-l[hidden]{display:none}
  .ck-l li{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--u) * 2);
    padding:calc(var(--u) * 1.5) 0;border-top:1px solid rgba(255,255,255,.16)}
  .ck-l li:last-child{border-bottom:1px solid rgba(255,255,255,.16)}
  .ck-n{display:block;font-size:12px;line-height:16px;letter-spacing:.08em;text-transform:uppercase}
  .ck-s{display:block;margin-top:calc(var(--u) / 2);color:rgba(255,255,255,.62);font-size:12px;line-height:16px}
  /* buttons: three equal columns, 5u tall, thin white outline, round ends, no fill */
  /* buttons: the site's .fx button, icons in a row at the bottom-right; the ones before an open one slide left */
  .ck-b{display:flex;justify-content:flex-end;gap:var(--u);margin-top:calc(var(--u) * 3)}
  .ck-b .fx>svg{fill:none}
  /* touch screens have no hover: there the buttons stay open, icon and label in a fine outline */
  @media (hover:none){
    .ck-b{justify-content:stretch}
    .ck-b .fx{flex:1;width:auto;height:40px;display:flex;align-items:center;justify-content:center;gap:6px;border-radius:999px;box-shadow:inset 0 0 0 1.5px #fff}
    .ck-b .fx>svg{width:18px;height:18px}
    .ck-b .fx .fx-p{display:none}
    .ck-b .fx .fx-t{position:static;opacity:1;transform:none;font-size:13px}
    .ck-b .fx:has(~ .fx:hover,~ .fx:focus-visible){transform:none}
  }
  .ck-b[hidden]{display:none}
  .ck-sw:focus-visible{outline:1.5px solid #fff;outline-offset:3px}
  /* the switch, Braun-like: an outline track; the knob is an outline ring when off, solid white when on */
  .ck-sw{appearance:none;background:none;margin:0;padding:0;flex:none;position:relative;cursor:pointer;
    width:calc(var(--u) * 5);height:calc(var(--u) * 3);border:1.5px solid rgba(255,255,255,.86);border-radius:999px;box-sizing:border-box}
  .ck-sw i{position:absolute;top:3px;left:3px;width:15px;height:15px;
    box-sizing:border-box;border:1.5px solid #fff;border-radius:50%;
    transition:transform .382s cubic-bezier(.16,1,.3,1),background-color .236s}
  .ck-sw[aria-checked="true"] i{transform:translateX(calc(var(--u) * 2));background:#fff}
  .ck-sw[aria-disabled="true"]{opacity:.42;cursor:default}
  /* footer button that reopens the panel: the shared .fx button, small, set level with the copyright line */
  .ck-o{margin:-8px 0 -8px calc(var(--u) * 1.5);vertical-align:middle;display:inline-grid}
  @media (max-width:640px){#ck{width:calc(100vw - 2 * var(--g))}}
  @media (prefers-reduced-motion:reduce){#ck,.ck-sw i{transition:none}}
</style>

<script>
  const KEY = 'ff-consent', VERSION = 1, PURPOSES = ['preferences', 'analytics', 'marketing'];
  const F = 1.618;
  const panel = document.getElementById('ck')!;
  const list = document.getElementById('ck-set')!, main = document.getElementById('ck-main')!, save = document.getElementById('ck-save')!;
  const switches = [...panel.querySelectorAll<HTMLButtonElement>('.ck-sw:not([aria-disabled])')];

  type Consent = { v: number; ts: string; necessary: true; preferences: boolean; analytics: boolean; marketing: boolean };
  const read = (): Consent | null => {
    try { const c = JSON.parse(localStorage.getItem(KEY) || 'null'); return c && c.v === VERSION ? c : null; } catch { return null; }
  };
  const publish = (c: Consent | null) => {
    (window as any).ffConsent = c;
    dispatchEvent(new CustomEvent('ff:consent', { detail: c }));
  };

  // the panel's foot sits on the same line as the indicators (bottom-left), so the copyright stays clear
  const ind = document.querySelector('.br');
  const align = () => { if (ind) panel.style.bottom = Math.max(0, innerHeight - ind.getBoundingClientRect().bottom) + 'px'; };
  addEventListener('resize', align);
  function show(settings = false) {
    align();
    const c = read();
    for (const s of switches) s.setAttribute('aria-checked', String(!!(c && (c as any)[s.dataset.k!])));
    list.hidden = !settings; main.hidden = settings; save.hidden = !settings; panel.classList.toggle('set', settings);
    panel.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('on')));
  }
  function hide() {
    panel.classList.remove('on');
    const done = () => { panel.hidden = true; };
    matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 618);
  }
  function store(pick: (k: string) => boolean) {
    const c = { v: VERSION, ts: new Date().toISOString(), necessary: true } as Consent;
    for (const k of PURPOSES) (c as any)[k] = pick(k);
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch {}
    publish(c); hide();
  }

  panel.addEventListener('click', e => {
    const t = (e.target as HTMLElement).closest('button');
    if (!t) return;
    if (t.classList.contains('ck-sw')) {
      if (t.getAttribute('aria-disabled') !== 'true') t.setAttribute('aria-checked', String(t.getAttribute('aria-checked') !== 'true'));
      return;
    }
    const a = t.dataset.a;
    if (a === 'accept') store(() => true);
    else if (a === 'reject') store(() => false);
    else if (a === 'settings') show(true);
    else if (a === 'save') store(k => panel.querySelector(`.ck-sw[data-k="${k}"]`)!.getAttribute('aria-checked') === 'true');
  });
  // Escape closes the settings back to the short view (it never accepts anything)
  panel.addEventListener('keydown', e => { if (e.key === 'Escape' && !list.hidden) { e.stopPropagation(); show(false); } });
  document.addEventListener('click', e => {
    if ((e.target as HTMLElement).closest('[data-ck-open]')) show(true);
  });

  const saved = read();
  publish(saved);
  // first visit: the panel arrives after φ² s, once the star and its greeting have had the stage
  if (!saved) setTimeout(() => show(false), F * F * 1000);
</script>
